// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?  @unique
  firstName String?
  lastName  String?
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("users")
}

model Project {
  id                String            @id @default(uuid())
  name              String
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  currentRevisionId String?
  currentRevision   ProjectRevision?  @relation("ProjectCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  messages       Message[]
  revisions      ProjectRevision[] @relation("ProjectRevisions")
  generationRuns GenerationRun[]
  specification  ProjectSpecification?

  @@index([userId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

model Message {
  id      String      @id @default(cuid())
  content String
  role    MessageRole
  type    MessageType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  generationRunId String?        @unique
  generationRun   GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)

  fragments Fragment?

  @@index([projectId, createdAt])
}

model Fragment {
  id        String  @id @default(cuid())
  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  sandboxUrl String
  title      String
  files      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GenerationRunStatus {
  QUEUED
  PLANNING
  AWAITING_APPROVAL
  DESIGNING
  ARCHITECTING
  RUNNING
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

model GenerationRun {
  id               String              @id @default(cuid())
  projectId        String
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String
  prompt           String
  status           GenerationRunStatus @default(QUEUED)
  baseRevisionId   String?
  resultRevisionId String?
  errorCode        String?
  errorMessage     String?
  attemptCount     Int                 @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  revisions ProjectRevision[]
  tasks     AgentTask[]
  events    RunEvent[]
  message   Message?

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model ProjectRevision {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation("ProjectRevisions", fields: [projectId], references: [id], onDelete: Cascade)
  generationRunId String?
  generationRun   GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  parentRevisionId String?
  parentRevision  ProjectRevision? @relation("RevisionHistory", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions  ProjectRevision[] @relation("RevisionHistory")
  revisionNumber  Int
  title           String         @default("Initial revision")
  summary         String?
  files           Json           // Complete immutable file tree snapshot: { [filePath]: fileContent }
  manifest        Json?          // File metadata: file count, size, sha hashes
  storageKey      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  currentForProjects Project[] @relation("ProjectCurrentRevision")

  @@unique([projectId, revisionNumber])
  @@index([projectId, createdAt])
}

enum SpecStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

model ProjectSpecification {
  id               String     @id @default(cuid())
  projectId        String     @unique
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prd              Json?      // ProductRequirementsDocument
  designSpec       Json?      // DesignSpecification
  architectureSpec Json?      // ArchitectureSpecification
  status           SpecStatus @default(DRAFT)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([projectId, status])
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model AgentTask {
  id         String        @id @default(cuid())
  runId      String
  run        GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  role       String        // planner | designer | architect | frontend | backend | database | integration | qa
  status     TaskStatus    @default(PENDING)
  attempt    Int           @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  output     Json?
  errorMsg   String?
  createdAt  DateTime      @default(now())

  @@index([runId, role])
}

model RunEvent {
  id        String        @id @default(cuid())
  runId     String
  run       GenerationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage     String
  agentRole String?
  message   String
  payload   Json?
  metricKey String?       @unique
  createdAt DateTime      @default(now())

  @@index([runId, createdAt])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventName     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  claimedAt     DateTime?
  nextAttemptAt DateTime?
  claimToken    String?
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
  @@index([claimToken])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
