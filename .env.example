# ─────────────────────────────────────────────────────────────────────────────
# CodeMytra — Environment Variable Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and configure your values.
# NEVER commit .env — only .env.example (this file) goes into version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── NEXT.JS ──────────────────────────────────────────────────────────────────
# The URL of your deployed app (no trailing slash).
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── DATABASE (Neon PostgreSQL) ───────────────────────────────────────────────
# Use the POOLED connection string for normal app queries (Prisma + PgBouncer).
# Required in production. Implicit localhost fallback is prohibited in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true

# Use the DIRECT (non-pooled) connection string for Prisma migrations only.
# Supported variable names: DATABASE_URL_DIRECT or DIRECT_URL
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ─── CLERK AUTHENTICATION ──────────────────────────────────────────────────────
# Create separate Clerk applications for development and production.
# Never mix dev keys with production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# Clerk redirect URLs (leave as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Set to "true" only in local development to run without Clerk keys.
# Protected API routes will fail closed in production regardless of this setting.
ALLOW_INSECURE_DEV_AUTH=false

# ─── OPENAI (Multi-Agent Reasoning & Coding - ACTIVE REQUIRED) ───────────────
# Required for multi-agent requirements planning, architecture, coding, and repair.
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ─── INNGEST (Multi-Agent Orchestration & Outbox Workers) ─────────────────────
# Inngest Dev Server runs locally — no keys needed for local development.
# For production, get keys from: https://app.inngest.com → your app → Secrets
INNGEST_EVENT_KEY=YOUR_INNGEST_EVENT_KEY
INNGEST_SIGNING_KEY=YOUR_INNGEST_SIGNING_KEY

# ─── E2B (Code Execution Sandboxes) ───────────────────────────────────────────
# Create your own E2B account at https://e2b.dev
# The API key is visible in: E2B Dashboard → API Keys
E2B_API_KEY=YOUR_E2B_API_KEY

# The template ID of your published E2B sandbox.
E2B_TEMPLATE_ID=YOUR_E2B_TEMPLATE_ID

# ─── OPERATIONAL & ORCHESTRATION LIMITS (Optional Overrides) ───────────────────
# Multi-agent QA repair attempt ceiling (default: 2)
# MAX_REPAIR_ATTEMPTS=2

# Maximum run execution timeout in milliseconds (default: 300000 = 5 minutes)
# MAX_GENERATION_DURATION_MS=300000

# Maximum simultaneous active generation runs per user (default: 3)
# MAX_CONCURRENT_RUNS_PER_USER=3

# Maximum project source files included in agent context (default: 30)
# MAX_INPUT_FILES_FOR_CONTEXT=30

# Fail closed on unconfigured rate limit backend (default: true in production)
# REQUIRE_ABUSE_PROTECTION=false

# Custom OpenAI token pricing override JSON (optional)
# MODEL_PRICING_CONFIG_JSON={"rates":{"gpt-4o":{"inputPerMillionUsd":2.50,"outputPerMillionUsd":10.0}}}

# ─── BILLING / PAYMENTS (Future) ──────────────────────────────────────────────
# Razorpay (India-first). Leave blank until billing is implemented.
# RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ─── OBJECT STORAGE (Future — for source snapshots and artifacts) ──────────────
# Not needed for MVP. Sandboxes and ZIP exports are self-contained.
# STORAGE_BUCKET_NAME=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=
